{
  "name": "simple-crm",
  "version": "0.1.0",
  "private": true,
  "description": "A light, fast, detail-focused CRM for small B2B teams. Next.js, Neon, Drizzle, Resend.",
  "license": "MIT",
  "author": "Logan Dziuk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gocougs2020/simple-crm.git"
  },
  "bugs": {
    "url": "https://github.com/gocougs2020/simple-crm/issues"
  },
  "homepage": "https://github.com/gocougs2020/simple-crm#readme",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:pipedrive": "tsx scripts/import-pipedrive.ts",
    "db:studio": "drizzle-kit studio",
    "email:dev": "email dev --dir src/emails"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.12",
    "@heroicons/react": "^2.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "next": "16.4.3",
    "papaparse": "^5.5.3",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.12",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
