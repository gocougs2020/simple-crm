{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0,15,30,45 * * * *"
    },
    {
      "path": "/api/cron/email-status",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/stripe",
      "schedule": "0 9 * * *"
    }
  ]
}
