{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm db:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/cron/campaigns",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/inbox",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/email-status",
      "schedule": "17 * * * *"
    }
  ]
}
