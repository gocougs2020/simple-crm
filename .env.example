# ── App ─────────────────────────────────────────────────────────────────
# Public URL, used in links inside emails (invites, password resets).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── Auth ────────────────────────────────────────────────────────────────
# Signs session cookies and unsubscribe links. Required in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Database: Neon Postgres (Vercel Marketplace → Storage → Neon) ───────
# Set automatically when you connect Neon to the Vercel project.
# Leave unset locally to use an embedded PGlite database in .data/.
DATABASE_URL=

# ── Email: Resend ───────────────────────────────────────────────────────
# Leave RESEND_API_KEY unset locally and emails print to the terminal.
RESEND_API_KEY=
# A sender on a domain verified in Resend (SPF + DKIM).
RESEND_FROM="Acme CRM <crm@acme.com>"

# Optional. The Resend domains this CRM manages, comma-separated. Set it when
# the Resend account is shared with another app: other domains and their
# inboxes are never listed, synced, sent from or removed. Unset = all of them.
RESEND_DOMAINS=

# Optional. Only if you create the Resend webhook yourself; otherwise
# Settings → Email domains → Connect webhook creates one and stores its secret.
RESEND_WEBHOOK_SECRET=

# Optional. Email forwarding (docs/AGENT.md#email-forwarding): a Resend domain
# with receiving turned on. The team's address is the agent's name there, e.g.
# agent@email.yourdomain.com. Never the domain your mailboxes use: receiving
# needs its MX record. A name that's a CNAME (a Vercel subdomain) can't have
# one; see the doc. Needs background work and the Resend webhook (reconnect it
# in Settings → Email domains after setting this).
FORWARD_EMAIL_DOMAIN=
# Optional. Receivers whose Authentication-Results lines are trusted for
# forwarded mail, comma-separated authserv-ids. Unset, a forward is accepted
# only with a DKIM signature from the sender's own domain, which the CRM
# checks itself. Settings → Agent shows the ids it saw on a refused email.
FORWARD_AUTHSERV_IDS=

# ── Billing: Stripe (optional) ──────────────────────────────────────────
# A restricted, read-only key: Customers, Subscriptions, Invoices, Charges,
# Products, Prices and Payment Methods. Shows billing on every client,
# matched by the emails of the client's people.
STRIPE_SECRET_KEY=
# More than one Stripe account: one key each, named by a suffix of your
# choice, with a label the app shows. The suffix (lowercased) is the
# account's id in the database, so don't rename it later.
# STRIPE_SECRET_KEY_A=
# STRIPE_ACCOUNT_LABEL_A="CoRecruit and TalentScout"
# STRIPE_SECRET_KEY_B=
# STRIPE_ACCOUNT_LABEL_B="ThirdPool and HiringCenter"

# ── Files: Vercel Blob (Vercel → Storage → Blob, private store) ─────────
# Leave unset locally and uploads are stored in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# ── Cron (Vercel sends this as a Bearer token to /api/cron/*) ───────────
CRON_SECRET=

# ── AI features: Vercel AI Gateway ──────────────────────────────────────
# The agent, voice chat, dictation and record summaries all run on this
# key, on Vercel too (the deployment's OIDC token isn't used), so the key's
# budget caps AI spend. Create one in the Vercel dashboard → AI Gateway → API
# keys; one per environment lets you cap each. Unset = AI features are hidden.
# Which features are on and which models they use are agent.* settings, set
# per deployment with NEXT_PUBLIC_APP_CONFIG (below; see docs/AGENT.md), e.g.
# NEXT_PUBLIC_APP_CONFIG='{"agent":{"voice":false,"chatModel":"anthropic/claude-sonnet-5.5"}}'
AI_GATEWAY_API_KEY=

# Optional. Signs the tokens the CRM and the agent's background agent
# (agent/, docs/AGENT.md) use with each other. Defaults to a key derived
# from AUTH_SECRET.
AGENT_RUN_SECRET=

# ── Knowledge source (optional) ─────────────────────────────────────────
# A read-only JSON API about your organization (usually your website's content
# API: pages, posts, resources). The agent, MCP agents and the REST API
# can then look things up there (tool get_knowledge). Every request stays
# under KNOWLEDGE_API_URL. Unset = off. See docs/KNOWLEDGE.md.
KNOWLEDGE_API_URL=
# Sent as Authorization: Bearer <key>. Use a read-only key.
KNOWLEDGE_API_KEY=
# Optional. Send the key in another header instead (as is), e.g. X-API-Key.
KNOWLEDGE_API_KEY_HEADER=
# Optional. What agents call it ("Acme website"), and what it covers and
# which paths answer what. The description is what agents go by.
KNOWLEDGE_NAME=
KNOWLEDGE_DESCRIPTION=
# Optional. Keep unpublished content out when the key can see it. Fixed query
# parameters replace the caller's on that path (space-separated entries);
# blocked paths are refused (* = one segment, trailing /* = everything below).
# KNOWLEDGE_FIXED_QUERY=/posts?status=live
# KNOWLEDGE_BLOCKED_PATHS=/posts/*
KNOWLEDGE_FIXED_QUERY=
KNOWLEDGE_BLOCKED_PATHS=

# ── Push notifications (Web Push) ───────────────────────────────────────
# Generate once with `pnpm dlx web-push generate-vapid-keys` and keep them:
# new keys turn notifications off on every device. Locally, leave unset and
# a pair is made in .data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:it@acme.com or your site URL.
VAPID_SUBJECT=

# ── Microsoft 365 (optional): each teammate's Outlook mailbox and calendar ──
# Register an app in Microsoft Entra ID (docs/MICROSOFT.md). Redirect URI:
# <NEXT_PUBLIC_SITE_URL>/api/integrations/microsoft/callback. Unset = hidden.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional: your tenant id or domain, so only your organization can connect.
# Defaults to "organizations" (any work or school account).
MICROSOFT_TENANT_ID=

# ── Calling and texting: Twilio (optional) ──────────────────────────────
# The account SID and a Standard API key (Twilio console → API keys & auth
# tokens). The key makes every Twilio API call and signs browser-call tokens.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The secret of a webhook signing key, to verify Twilio's webhooks
# (comma-separated while rotating). See docs/PHONE.md for setting it up.
TWILIO_WEBHOOK_SECRET=
# Optional (MG…). Numbers bought in Settings are added to this messaging
# service, for A2P 10DLC texting in the US. Set its Integration to "Defer to
# sender's webhook".
TWILIO_MESSAGING_SERVICE_SID=
# Optional. Settings → Phone numbers → Set up calling creates the TwiML app.
TWILIO_TWIML_APP_SID=
# Legacy, optional: the auth token works instead of the API key, and checks
# webhooks Twilio signs with it (all of them until a signing key is set up).
TWILIO_AUTH_TOKEN=

# Optional. Encrypts stored Microsoft tokens and the Twilio API key secret.
# Defaults to a key derived from AUTH_SECRET. Changing it (or AUTH_SECRET,
# when this is unset) means teammates reconnect Microsoft.
TOKEN_ENCRYPTION_KEY=

# ── Pipedrive import (optional, only for `pnpm import:pipedrive`) ────────
# Pipedrive → Personal preferences → API. An admin's token sees everything.
PIPEDRIVE_API_TOKEN=
# Your Pipedrive subdomain (acme for acme.pipedrive.com). Optional.
PIPEDRIVE_COMPANY_DOMAIN=

# ── Branding (optional, public) ─────────────────────────────────────────
# Per-deployment overrides for app.config.ts, so a fork never has to edit it.
# Compiled into the page: never put secrets here. Restart / redeploy after a
# change. Unknown keys or wrong types fail the build. See docs/THEMING.md.
# Quote any value containing # (colors, JSON): unquoted, # starts a comment.
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_BRAND_COLOR=
# NEXT_PUBLIC_BRAND_COLOR="#2f629f"
# NEXT_PUBLIC_APP_CONFIG='{"layout":{"defaultClientsView":"table"},"theme":{"tokens":{"canvas":"#f7f5f0"}}}'
NEXT_PUBLIC_APP_CONFIG=
