# ── App ─────────────────────────────────────────────────────────────────
# Public URL, used in links inside emails (invites, password resets).
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# ── Auth ────────────────────────────────────────────────────────────────
# Signs session cookies and unsubscribe links. Required in production.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Database: Neon Postgres (Vercel Marketplace → Storage → Neon) ───────
# Set automatically when you connect Neon to the Vercel project.
# Leave unset locally to use an embedded PGlite database in .data/.
DATABASE_URL=

# ── Email: Resend ───────────────────────────────────────────────────────
# Leave RESEND_API_KEY unset locally and emails print to the terminal.
RESEND_API_KEY=
# A sender on a domain verified in Resend (SPF + DKIM).
RESEND_FROM="Acme CRM <crm@acme.com>"

# Optional. The Resend domains this CRM manages, comma-separated. Set it when
# the Resend account is shared with another app: other domains and their
# inboxes are never listed, synced, sent from or removed. Unset = all of them.
RESEND_DOMAINS=

# Optional. Only if you create the Resend webhook yourself; otherwise
# Settings → Email domains → Connect webhook creates one and stores its secret.
RESEND_WEBHOOK_SECRET=

# ── Billing: Stripe (optional) ──────────────────────────────────────────
# A restricted, read-only key: Customers, Subscriptions, Invoices, Charges,
# Products. Shows billing on current and past clients.
STRIPE_SECRET_KEY=

# ── Files: Vercel Blob (Vercel → Storage → Blob, private store) ─────────
# Leave unset locally and uploads are stored in .data/uploads.
BLOB_READ_WRITE_TOKEN=

# ── Cron (Vercel sends this as a Bearer token to /api/cron/*) ───────────
CRON_SECRET=

# ── Pipedrive import (optional, only for `pnpm import:pipedrive`) ────────
# Pipedrive → Personal preferences → API. An admin's token sees everything.
PIPEDRIVE_API_TOKEN=
# Your Pipedrive subdomain (acme for acme.pipedrive.com). Optional.
PIPEDRIVE_COMPANY_DOMAIN=
